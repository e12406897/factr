{
    "name": "FACTR ROS2",

    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "args": {
            "USERNAME": "asl_team",
            "USER_UID": "10416207",
            "USER_GID": "10400513"
        }
    },

    "remoteUser": "asl_team",

    // Without this, Dev Containers replaces the image's ENTRYPOINT/CMD with its own
    // keep-alive wrapper (visible as PID 1) so the container survives even if CMD would
    // otherwise exit immediately without a TTY — but that silently skips our custom
    // entrypoint.sh (root-only USB latency_timer setup) entirely. Disabling it makes
    // Dev Containers respect the Dockerfile's own ENTRYPOINT/CMD; see Dockerfile's CMD
    // (sleep infinity) for how the container now stays alive on its own instead.
    "overrideCommand": false,

    "workspaceFolder": "/factr",

    "workspaceMount": "source=${localWorkspaceFolder},target=/factr,type=bind",

    "runArgs": [
        "--gpus=all",
        "--privileged",
        "-e",
        "DISPLAY=${env:DISPLAY}",
        "-e",
        "QT_X11_NO_MITSHM=1",
        // The nvcr.io CUDA base image defaults to NVIDIA_DRIVER_CAPABILITIES=compute,utility,
        // so the NVIDIA runtime never mounts libEGL_nvidia/libGLX_nvidia into the container.
        // EGL then falls back to Mesa, which lacks EGL_EXT_platform_device and fails with
        // "Cannot initialize a EGL device display" -- breaking robosuite's offscreen camera
        // rendering. Requesting graphics capabilities injects the GL/EGL driver libraries.
        "-e",
        "NVIDIA_DRIVER_CAPABILITIES=all",
        "--network=host",
        "--cap-add=SYS_NICE",
        "--ulimit=rtprio=99",
        "--ulimit=memlock=-1",
        // Host GIDs of /dev/dri/card0 (44, "video") and /dev/dri/renderD128 (109,
        // "render"). Without these the container user can't open the GPU device nodes,
        // so headless/offscreen rendering (EGL -- used by robosuite's camera
        // observations) fails with "Permission denied" while the on-screen viewer still
        // works (that one goes through the host's X server). --privileged does NOT
        // cover this: it grants capabilities, not file ownership/permission bits.
        // Re-check with `ls -ln /dev/dri/` on the host if the GIDs ever change.
        "--group-add", "44",
        "--group-add", "109"
    ],

    "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/dev/serial/by-id,target=/dev/serial/by-id,type=bind",
    "source=/home/asl_team/catkin_ws/devel/lib/libfranka_hw.so,target=/usr/local/lib/libfranka_hw.so,type=bind",
    "source=/home/asl_team/catkin_ws/devel/lib/libfranka_control_services.so,target=/usr/local/lib/libfranka_control_services.so,type=bind",
    "source=/home/asl_team/libfranka/build,target=/home/asl_team/libfranka/build,type=bind",
    "source=/home/asl_team/libfranka/include,target=/home/asl_team/libfranka/include,type=bind",
    "source=/lib/x86_64-linux-gnu/libPocoNet.so.62,target=/lib/x86_64-linux-gnu/libPocoNet.so.62,type=bind",
    "source=/lib/x86_64-linux-gnu/libPocoFoundation.so.62,target=/lib/x86_64-linux-gnu/libPocoFoundation.so.62,type=bind"
    ],

    "containerEnv": {
        "Franka_DIR": "/home/asl_team/libfranka/build",
        "ROS_DOMAIN_ID": "42"
    },

    "postCreateCommand": "bash .devcontainer/post_create.sh",
    "postStartCommand": "bash -lc 'fuser -k 16098/tcp 16099/tcp 16087/tcp 2>/dev/null || true'",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-python.isort",
                "charliermarshar.ruff"
            ],

            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",

                "python.linting.enabled": true,
                "python.linting.pylintEnabled": false,

                "python.formatting.provider": "black",
                "python.formatting.blackPath": "/usr/local/bin/black",

                "editor.formatOnSave": true,

                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                },

                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                }
            }
        }
    }
}