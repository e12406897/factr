{
    "name": "FACTR ROS2",

    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "args": {
            "USERNAME": "asl_team",
            "USER_UID": "10416207",
            "USER_GID": "10400513"
        }
    },

    "remoteUser": "asl_team",

    "workspaceFolder": "/factr",

    "workspaceMount": "source=${localWorkspaceFolder},target=/factr,type=bind",

    "runArgs": [
        "--gpus=all",
        "--privileged",
        "-e",
        "DISPLAY=${env:DISPLAY}",
        "-e",
        "QT_X11_NO_MITSHM=1",
        "--network=host",
        "--cap-add=SYS_NICE",
        "--ulimit=rtprio=99",
        "--ulimit=memlock=-1"
    ],

    "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/dev/serial/by-id,target=/dev/serial/by-id,type=bind",
    "source=/home/asl_team/catkin_ws/devel/lib/libfranka_hw.so,target=/usr/local/lib/libfranka_hw.so,type=bind",
    "source=/home/asl_team/catkin_ws/devel/lib/libfranka_control_services.so,target=/usr/local/lib/libfranka_control_services.so,type=bind",
    "source=/home/asl_team/libfranka/build,target=/home/asl_team/libfranka/build,type=bind",
    "source=/home/asl_team/libfranka/include,target=/home/asl_team/libfranka/include,type=bind",
    "source=/lib/x86_64-linux-gnu/libPocoNet.so.62,target=/lib/x86_64-linux-gnu/libPocoNet.so.62,type=bind",
    "source=/lib/x86_64-linux-gnu/libPocoFoundation.so.62,target=/lib/x86_64-linux-gnu/libPocoFoundation.so.62,type=bind"
    ],

    "containerEnv": {
        "Franka_DIR": "/home/asl_team/libfranka/build"
    },

    "postCreateCommand": "bash -lc 'source /opt/ros/humble/setup.bash && FRANKA_ROS2_VERSION=v0.1.0 && [ -d src/franka_ros2 ] || git clone --branch $FRANKA_ROS2_VERSION --depth 1 https://github.com/frankarobotics/franka_ros2.git src/franka_ros2 && rosdep update && rosdep install --from-paths src --ignore-src -r -y --skip-keys libfranka && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DCMAKE_CXX_FLAGS=-I/home/asl_team/libfranka/include'",
    "postStartCommand": "bash -lc 'fuser -k 16098/tcp 16099/tcp 16087/tcp 2>/dev/null || true'",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-python.isort",
                "charliermarshar.ruff"
            ],

            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",

                "python.linting.enabled": true,
                "python.linting.pylintEnabled": false,

                "python.formatting.provider": "black",
                "python.formatting.blackPath": "/usr/local/bin/black",

                "editor.formatOnSave": true,

                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                },

                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                }
            }
        }
    }
}